diff --git a/lifeonair/code/a5_genome_traits.R b/lifeonair/code/a5_genome_traits.R
new file mode 100644
index 0000000..26bdb21
--- /dev/null
+++ b/lifeonair/code/a5_genome_traits.R
@@ -0,0 +1,38 @@
+#!/usr/bin/env Rscript
+# Life on air (P3): genomic traits of atmospheric-guild carriers (review round 1, consultation A5).
+# Do group 1l carriers differ from 1h carriers (and non-carriers) in estimated genome size, GC content or
+# gRodon doubling time, within order? Genome size is completeness-adjusted (length / completeness, CheckM2),
+# from IBEX 06_atmospheric/lifeonair_review_r1 job 53611804 (results/inputs/rep_genome_size.tsv).
+#   Rscript lifeonair/code/a5_genome_traits.R   -> lifeonair/results/a5_genome_traits/
+suppressPackageStartupMessages(library(lme4))
+IN <- "lifeonair/results/inputs"; OUT <- "lifeonair/results/a5_genome_traits"; dir.create(OUT, showWarnings = FALSE)
+rd <- function(f, ...) read.delim(f, check.names = FALSE, quote = "", ...)
+ORPHANS <- readLines("lifeonair/results/reads/orphan_sub_reps.txt")
+gs <- rd(file.path(IN, "rep_genome_size.tsv")); gs <- gs[!gs$genome_id %in% ORPHANS, ]
+gr <- rd(file.path(IN, "rep_growth_v2.tsv"))
+gs$logd <- log(gr$d_hours[match(gs$genome_id, gr$rep)])
+gs$est_mb <- gs$length_bp / (gs$completeness / 100) / 1e6
+cls <- rd(file.path(IN, "atmo_classification_v2.tsv")); cls <- cls[!cls$rep_id %in% ORPHANS, ]
+g <- function(x) unique(cls$rep_id[cls$marker == "hydB" & grepl(paste0("Group_", x, "$"), cls$assignment)])
+gs$c1l <- gs$genome_id %in% g("1l"); gs$c1h <- gs$genome_id %in% g("1h"); gs$c2a <- gs$genome_id %in% g("2a")
+gs$cfI <- gs$genome_id %in% setdiff(readLines(file.path(IN, "guild_coxL_reps_v2.txt")), ORPHANS)
+tax <- rbind(rd(file.path(IN, "r232_bac120.summary.tsv"))[, 1:2], rd(file.path(IN, "r232_ar53.summary.tsv"))[, 1:2])
+rk <- function(cl, p) ifelse(grepl(paste0(p, "__[^;]"), cl), sub(paste0(".*", p, "__([^;]*).*"), "\\1", cl), "unassigned")
+cl <- tax$classification[match(gs$genome_id, tax$user_genome)]
+gs$order <- paste(rk(cl, "p"), rk(cl, "o"), sep = ";")
+gs$group <- ifelse(gs$c1l & gs$c1h, "1l+1h", ifelse(gs$c1l, "1l_only", ifelse(gs$c1h, "1h_only", "neither")))
+desc <- do.call(rbind, lapply(split(gs, gs$group), function(d) data.frame(group = d$group[1], n = nrow(d),
+  median_est_Mb = median(d$est_mb), median_gc = median(d$gc), median_doubling_h = median(exp(d$logd), na.rm = TRUE),
+  median_completeness = median(d$completeness))))
+fit <- function(resp) {
+  m <- lmer(as.formula(paste(resp, "~ c1l + c1h + c2a + cfI + (1 | order)")), gs)
+  co <- summary(m)$coefficients
+  data.frame(response = resp, term = rownames(co)[-1], estimate = co[-1, 1], se = co[-1, 2],
+             p_wald = 2 * pnorm(-abs(co[-1, 3])))
+}
+gs$log_est_mb <- log(gs$est_mb); gs$gc100 <- 100 * gs$gc
+mod <- do.call(rbind, lapply(c("log_est_mb", "gc100", "logd"), fit))
+mod$q_BH <- p.adjust(mod$p_wald, "BH")
+write.table(desc, file.path(OUT, "trait_medians_by_group.tsv"), sep = "\t", quote = FALSE, row.names = FALSE)
+write.table(mod, file.path(OUT, "trait_models_within_order.tsv"), sep = "\t", quote = FALSE, row.names = FALSE)
+print(desc); print(mod, digits = 3)
diff --git a/lifeonair/code/apply_sub_fix.py b/lifeonair/code/apply_sub_fix.py
new file mode 100644
index 0000000..03abadf
--- /dev/null
+++ b/lifeonair/code/apply_sub_fix.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Life on air (P3): carrier lists and trait inputs restricted to retained contigs (review round 1, R1-19).
+
+s1_sub_reconcile.sh (IBEX job 53614016) mapped every CDS of the 1,010 "_sub" representatives to whether its
+contig is retained in the representative. Proteins on removed contigs are genuine community genes, so reads
+assigned to them keep their label and the read-based genome equivalents are unchanged; but they must not make
+the representative a carrier, nor enter its gRodon estimate. This script writes:
+  inputs/atmo_classification_v2.tsv  typed hydB/coxL rows minus proteins on removed contigs and orphan reps
+  inputs/guild_coxL_reps_v2.txt      reps with >= 1 retained form-I CoxL (corrected calls, fix_coxL_v2.py)
+  inputs/rep_growth_v2.tsv           rep_growth.tsv with _sub rows replaced by the retained-CDS estimates
+
+    python3 lifeonair/code/apply_sub_fix.py
+"""
+import csv
+import gzip
+
+IN = "lifeonair/results/inputs"
+ret = {}
+for r in csv.DictReader(gzip.open(f"{IN}/sub_protein_retention.tsv.gz", "rt"), delimiter="\t"):
+    ret[(r["rep"], r["protein_id"])] = r["retained"] == "1"
+orph = set(open("lifeonair/results/reads/orphan_sub_reps.txt").read().split())
+keep = lambda rep, pid: rep not in orph and ret.get((rep, pid), True)
+
+rows = list(csv.DictReader(open(f"{IN}/atmo_classification.tsv"), delimiter="\t"))
+kept = [r for r in rows if keep(r["rep_id"], r["protein_id"])]
+with open(f"{IN}/atmo_classification_v2.tsv", "w", newline="") as f:
+    w = csv.DictWriter(f, fieldnames=list(rows[0]), delimiter="\t"); w.writeheader(); w.writerows(kept)
+print(f"atmo_classification: {len(rows)} -> {len(kept)} rows")
+for g in ("Group_1l", "Group_1h", "Group_2a"):
+    b = {r["rep_id"] for r in rows if r["marker"] == "hydB" and r["assignment"].endswith(g)}
+    a = {r["rep_id"] for r in kept if r["marker"] == "hydB" and r["assignment"].endswith(g)}
+    print(f"  {g} carriers {len(b)} -> {len(a)}")
+
+cx = [r for r in csv.DictReader(open(f"{IN}/coxL_class_v2.tsv"), delimiter="\t") if r["form_call"] == "form_I"]
+reps = sorted({r["query"].split("|")[0] for r in cx if keep(*r["query"].split("|"))})
+old = open(f"{IN}/guild_coxL_reps_v2.txt").read().split()
+open(f"{IN}/guild_coxL_reps_v2.txt", "w").write("\n".join(reps) + "\n")
+print(f"form-I carriers {len(old)} -> {len(reps)} (proteins {sum(keep(*r['query'].split('|')) for r in cx)})")
+
+fix = {r["rep"]: r for r in csv.DictReader(open(f"{IN}/rep_growth_sub_fixed.tsv"), delimiter="\t")}
+g = list(csv.DictReader(open(f"{IN}/rep_growth.tsv"), delimiter="\t"))
+with open(f"{IN}/rep_growth_v2.tsv", "w", newline="") as f:
+    w = csv.DictWriter(f, fieldnames=list(g[0]), delimiter="\t"); w.writeheader()
+    for r in g:
+        w.writerow(fix.get(r["rep"], r))
+print(f"growth: {len(fix)} _sub reps re-estimated")
diff --git a/lifeonair/code/b1_classifier_benchmark.sh b/lifeonair/code/b1_classifier_benchmark.sh
new file mode 100644
index 0000000..1760bef
--- /dev/null
+++ b/lifeonair/code/b1_classifier_benchmark.sh
@@ -0,0 +1,207 @@
+#!/bin/bash
+# Life on air (P3): held-out benchmark of the read classifier (review round 1, finding R1-20).
+#
+# How often is a 100-nt read from a hydrogenase or CoxL gene assigned to the right label when its source
+# is absent from the competitive database? Two hold-out schemes, five folds each:
+#   genome  hold out all marker proteins of 20% of the representatives (relatives stay in the database)
+#   clu50   cluster all EQ marker proteins at 50% identity (MMseqs2, coverage 0.5) and hold out 20% of the
+#           clusters, so that no database protein shares >= 50% identity with the read's source protein
+# For each fold the database is rebuilt without the held-out EQ proteins (HydDB and Cordero references
+# and the SCG set stay), 100-nt fragments are tiled every 30 nt over each held-out gene (alternating
+# strand), and 50 random non-marker CDS per held-out genome are tiled the same way as negatives. Reads are
+# searched exactly as in r2_reads_array.sh (DIAMOND blastx --id 50 --evalue 1e-5 --max-target-seqs 1,
+# best hit with alignment >= 25 aa) and the assigned label is tabulated against the true label at the
+# 50/60/70% identity floors. Labels are those of marker_labels_v2.tsv (corrected CoxL forms, group 2a).
+#
+#   sbatch b1_classifier_benchmark.sh      (workbench 06_atmospheric/lifeonair_review_r1)
+#
+#SBATCH --job-name=loa_bench
+#SBATCH --output=/ibex/scratch/projects/c2014/rob/metagenomics/06_atmospheric/lifeonair_review_r1/logs/bench_%j.out
+#SBATCH --error=/ibex/scratch/projects/c2014/rob/metagenomics/06_atmospheric/lifeonair_review_r1/logs/bench_%j.err
+#SBATCH --cpus-per-task=32
+#SBATCH --mem=64G
+#SBATCH --time=12:00:00
+#SBATCH --partition=batch
+
+set -euo pipefail
+R=/ibex/scratch/projects/c2014/rob/metagenomics
+W=$R/06_atmospheric/lifeonair_review_r1
+DB=$R/06_atmospheric/lifeonair_reads/db
+B=$W/bench
+CONDA=/ibex/scratch/projects/c2014/rob/miniconda3/envs
+DIAMOND=$CONDA/eggnog/bin/diamond
+MMSEQS=$CONDA/mmseqs2/bin/mmseqs
+T=${SLURM_CPUS_PER_TASK:-32}
+source "$CONDA/../bin/activate" bakta   # any env with python3
+mkdir -p "$B" "$W/logs" "$W/results"
+LAB=$W/inputs/marker_labels_v2.tsv       # copied from lifeonair/results/reads/db/marker_labels_v2.tsv
+[ -s "$LAB" ] || { echo "ERROR: $LAB missing"; exit 1; }
+
+echo "[$(date -Iseconds)] cluster EQ marker proteins at 50% identity"
+awk '/^>/{p = ($0 ~ /^>EQ\|/)} p' "$DB/markers.faa" > "$B/eq_markers.faa"
+"$MMSEQS" easy-cluster "$B/eq_markers.faa" "$B/clu50" "$B/tmp_clu" --min-seq-id 0.5 -c 0.5 \
+    --threads "$T" >/dev/null 2>&1
+rm -rf "$B/tmp_clu"
+
+echo "[$(date -Iseconds)] folds, gene nucleotide sequences and fragments"
+python3 - "$R" "$B" "$LAB" <<'PY'
+import csv, os, random, sys
+R, B, LAB = sys.argv[1:4]
+TREE = "/ibex/scratch/projects/c2014/EmptyQuarter_Data/processed/sequencing-results/sites"
+meta = {r["sample"]: r for r in csv.DictReader(open(f"{R}/metadata/sample_metadata.tsv"), delimiter="\t")}
+
+def resolve(rep):                              # same resolver as r1_build_db.sh
+    sample = rep.split("__")[0]; m = meta.get(sample)
+    if "__" not in rep or not m:
+        return None
+    tok, local = rep.split("__", 1)[1].split("_", 1)
+    anno = "single_sample" if tok == "single" else "self_supervised"
+    base = f"{TREE}/{m['trip']}/site{m['site']}/{sample}/wgs/annotation/{anno}/bakta"
+    for lc in [local] + ([local[:-4]] if local.endswith("_sub") else []):
+        p = f"{base}/{lc}/{lc}.ffn"
+        if os.path.exists(p):
+            return p
+    return None
+
+def read_fa(path):
+    name, seq = None, []
+    for line in open(path):
+        if line.startswith(">"):
+            if name is not None: yield name, "".join(seq)
+            name, seq = line[1:].split()[0], []
+        else: seq.append(line.strip())
+    if name is not None: yield name, "".join(seq)
+
+label = {r["subject"]: (r["marker"], r["label"]) for r in csv.DictReader(open(LAB), delimiter="\t")
+         if r["subject"].startswith("EQ|")}
+clu = {m: c for c, m in (l.rstrip("\n").split("\t") for l in open(f"{B}/clu50_cluster.tsv"))}
+reps = sorted({s.split("|")[2] for s in label})
+rng = random.Random(7)
+rfold = {r: i % 5 for i, r in enumerate(rng.sample(reps, len(reps)))}
+cl = sorted(set(clu.values()))
+cfold = {c: i % 5 for i, c in enumerate(rng.sample(cl, len(cl)))}
+with open(f"{B}/folds.tsv", "w") as o:
+    o.write("subject\tmarker\tlabel\tcluster50\tfold_genome\tfold_clu50\n")
+    for s, (m, l) in sorted(label.items()):
+        o.write(f"{s}\t{m}\t{l}\t{clu[s]}\t{rfold[s.split('|')[2]]}\t{cfold[clu[s]]}\n")
+
+def tile(seq, step=30, L=100):
+    rc = str.maketrans("ACGTN", "TGCAN")
+    for k, i in enumerate(range(0, max(len(seq) - L, 0) + 1, step)):
+        f = seq[i:i + L]
+        yield f if k % 2 == 0 else f.translate(rc)[::-1]
+
+by_rep = {}
+for s in label:
+    by_rep.setdefault(s.split("|")[2], set()).add(s.split("|")[3])
+nmiss = 0
+with open(f"{B}/fragments.fa", "w") as o, open(f"{B}/fragments_truth.tsv", "w") as t:
+    t.write("read\tsource\tmarker\tlabel\n")
+    for rep, pids in sorted(by_rep.items()):
+        p = resolve(rep)
+        if not p:
+            nmiss += 1; continue
+        seqs = dict(read_fa(p))
+        for pid in sorted(pids):
+            subj = [k for k in (f"EQ|hydB|{rep}|{pid}", f"EQ|coxL|{rep}|{pid}") if k in label][0]
+            g = seqs.get(pid)
+            if not g:
+                continue
+            for j, f in enumerate(tile(g.upper())):
+                rid = f"{subj}#{j}"
+                o.write(f">{rid}\n{f}\n"); t.write(f"{rid}\t{subj}\t{label[subj][0]}\t{label[subj][1]}\n")
+        others = [k for k in seqs if k not in pids and len(seqs[k]) >= 300]
+        for pid in rng.sample(others, min(50, len(others))):
+            for j, f in enumerate(tile(seqs[pid].upper(), step=150)):
+                rid = f"NEG|{rep}|{pid}#{j}"
+                o.write(f">{rid}\n{f}\n"); t.write(f"{rid}\tNEG|{rep}|{pid}\tnone\tnone\n")
+print(f"reps {len(reps)}; unresolved {nmiss}; clusters {len(cl)}", flush=True)
+PY
+
+for SCHEME in genome clu50; do
+  for F in 0 1 2 3 4; do
+    D=$B/${SCHEME}_f$F; mkdir -p "$D"
+    [ -s "$D/hits.tsv" ] && continue
+    COL=$([ "$SCHEME" = genome ] && echo 5 || echo 6)
+    awk -F'\t' -v c=$COL -v f=$F 'NR > 1 && $c == f {print $1}' "$B/folds.tsv" > "$D/heldout.txt"
+    awk 'NR == FNR {h[">" $1]; next} /^>/{p = !(($1) in h)} p' "$D/heldout.txt" "$DB/loa_reads.faa" > "$D/db.faa"
+    "$DIAMOND" makedb --in "$D/db.faa" -d "$D/db" -p "$T" --quiet
+    # reads: fragments of the held-out marker genes plus negatives from the genomes of held-out proteins
+    python3 - "$D/heldout.txt" "$B/fragments.fa" "$D/reads.fa" <<'PY'
+import sys
+held = {l.strip() for l in open(sys.argv[1])}
+reps = {h.split("|")[2] for h in held}
+keep = False
+with open(sys.argv[3], "w") as o:
+    for line in open(sys.argv[2]):
+        if line.startswith(">"):
+            rid = line[1:].strip(); src = rid.split("#")[0]
+            keep = src in held or (src.startswith("NEG|") and src.split("|")[1] in reps)
+        if keep:
+            o.write(line)
+PY
+    "$DIAMOND" blastx -q "$D/reads.fa" -d "$D/db" -p "$T" --id 50 --evalue 1e-5 --max-target-seqs 1 \
+        --outfmt 6 qseqid sseqid pident length evalue bitscore --quiet -o "$D/hits.tsv"
+    rm -f "$D/db.faa" "$D/db.dmnd"
+    echo "[$(date -Iseconds)] $SCHEME fold $F: $(grep -c '^>' "$D/reads.fa") reads, $(cut -f1 "$D/hits.tsv" | sort -u | wc -l) hit"
+  done
+done
+
+echo "[$(date -Iseconds)] tabulate"
+python3 - "$B" "$DB/marker_labels.tsv" "$LAB" "$W/results" <<'PY'
+import csv, sys
+from collections import Counter
+B, LAB0, LAB, OUT = sys.argv[1:5]
+lab = {r["subject"]: r["label"] for r in csv.DictReader(open(LAB0), delimiter="\t")}
+lab.update({r["subject"]: r["label"] for r in csv.DictReader(open(LAB), delimiter="\t")})
+def group(l):
+    for k, g in (("Group_1l", "hydB_1l"), ("Group_1h", "hydB_1h"), ("Group_2a", "hydB_2a")):
+        if l.endswith(k): return g
+    if l == "form_I": return "coxL_formI"
+    if l in ("form_II", "coxL_other", "coxL_unresolved"): return "coxL_other"
+    if l in ("none",): return "none"
+    if "NiFe" in l or "FeFe" in l or "Fe" in l: return "other_nife"
+    return "SCG"
+truth = {r["read"]: group(r["label"]) for r in csv.DictReader(open(f"{B}/fragments_truth.tsv"), delimiter="\t")}
+rows = []
+for scheme in ("genome", "clu50"):
+    for floor in (50, 60, 70):
+        c = Counter(); n = Counter()
+        for f in range(5):
+            D = f"{B}/{scheme}_f{f}"
+            held = {l.strip() for l in open(f"{D}/heldout.txt")}
+            reps = {h.split("|")[2] for h in held}
+            best = {}
+            for line in open(f"{D}/hits.tsv"):
+                q, s, pid, aln = line.split("\t")[:4]
+                if q not in best and int(aln) >= 25:
+                    best[q] = (s, float(pid))
+            for rid, t in truth.items():
+                src = rid.split("#")[0]
+                if not (src in held or (src.startswith("NEG|") and src.split("|")[1] in reps)):
+                    continue
+                n[t] += 1
+                h = best.get(rid)
+                a = group(lab[h[0]]) if h and h[1] >= floor else "unassigned"
+                c[(t, a)] += 1
+        for (t, a), k in sorted(c.items()):
+            rows.append((scheme, floor, t, a, k, n[t], k / n[t]))
+with open(f"{OUT}/classifier_benchmark_confusion.tsv", "w") as o:
+    o.write("scheme\tid_floor\ttrue\tassigned\treads\treads_true\tfraction\n")
+    for r in rows: o.write("\t".join(map(str, r[:-1])) + f"\t{r[-1]:.4f}\n")
+# precision / recall per marker group (negatives and SCG counted as possible false positives)
+with open(f"{OUT}/classifier_benchmark_summary.tsv", "w") as o:
+    o.write("scheme\tid_floor\tgroup\trecall\tprecision\tassigned_reads\n")
+    for scheme in ("genome", "clu50"):
+        for floor in (50, 60, 70):
+            sub = [r for r in rows if r[0] == scheme and r[1] == floor]
+            for g in ("hydB_1l", "hydB_1h", "hydB_2a", "other_nife", "coxL_formI", "coxL_other"):
+                tp = sum(r[4] for r in sub if r[2] == g and r[3] == g)
+                pos = sum(r[4] for r in sub if r[2] == g)
+                ass = sum(r[4] for r in sub if r[3] == g)
+                o.write(f"{scheme}\t{floor}\t{g}\t{tp / pos if pos else float('nan'):.4f}\t"
+                        f"{tp / ass if ass else float('nan'):.4f}\t{ass}\n")
+print(open(f"{OUT}/classifier_benchmark_summary.tsv").read())
+PY
+sha256sum "$W/results/classifier_benchmark_"*.tsv "$B/folds.tsv" > "$W/results/classifier_benchmark.sha256"
+echo "[$(date -Iseconds)] done"
diff --git a/lifeonair/code/decontam_batch.R b/lifeonair/code/decontam_batch.R
new file mode 100644
index 0000000..294a8f8
--- /dev/null
+++ b/lifeonair/code/decontam_batch.R
@@ -0,0 +1,31 @@
+#!/usr/bin/env Rscript
+# Life on air (P3): batch-stratified decontam frequency screen (review round 1, finding R1-23).
+# decontam_screen.R pooled all expeditions and extraction kits, so its frequency test compared samples
+# whose DNA yield differs by batch. Here the two models (abundance independent of DNA concentration vs
+# proportional to 1/concentration) are compared after centring within expedition x extraction kit, with a
+# pooled F statistic over strata (df = n - number of strata). Flags at score < 0.1 with >= 10 samples.
+#   Rscript lifeonair/code/decontam_batch.R   -> lifeonair/results/decontam/rep_frequency_by_batch.tsv
+IN <- "lifeonair/results/inputs"; OUT <- "lifeonair/results/decontam"
+rd <- function(f, ...) read.delim(f, quote = "", comment.char = "", check.names = FALSE, ...)
+ab <- rd(gzfile(file.path(IN, "coverm_rep_abundance_long.tsv.gz")), header = FALSE, col.names = c("sample", "rep", "abund"))
+ab <- ab[ab$rep != "unmapped" & is.finite(ab$abund) & ab$abund > 0, ]
+led <- rd(file.path(IN, "sample_ledger_dna.tsv")); led$conc <- suppressWarnings(as.numeric(led$dna_concentration))
+led <- led[is.finite(led$conc) & led$conc > 0, ]
+nu <- tapply(led$conc, led$sample_id, function(x) length(unique(round(x, 6))))
+led <- led[!led$sample_id %in% names(nu)[nu > 1] & !duplicated(led$sample_id), ]
+led$batch <- paste(tolower(led$trip), led$dna_kit)
+ab <- ab[ab$sample %in% led$sample_id, ]
+ab$batch <- led$batch[match(ab$sample, led$sample_id)]; ab$x <- log(led$conc[match(ab$sample, led$sample_id)])
+cat("samples", length(unique(ab$sample)), "batches:\n"); print(table(led$batch[led$sample_id %in% ab$sample]))
+res <- do.call(rbind, lapply(split(ab, ab$rep), function(d) {
+  n <- nrow(d); k <- length(unique(d$batch))
+  if (n < 10 || n - k < 5) return(data.frame(rep = d$rep[1], n_present = n, n_batches = k, score = NA))
+  y <- log(d$abund); r1 <- y + d$x
+  cy <- y - ave(y, d$batch); cr <- r1 - ave(r1, d$batch)
+  data.frame(rep = d$rep[1], n_present = n, n_batches = k, score = pf(sum(cr^2) / sum(cy^2), n - k, n - k))
+}))
+res$flag <- !is.na(res$score) & res$score < 0.1
+write.table(res, file.path(OUT, "rep_frequency_by_batch.tsv"), sep = "\t", quote = FALSE, row.names = FALSE)
+g <- unique(c(readLines(file.path(IN, "guild_hydB_reps.txt")), readLines(file.path(IN, "guild_coxL_reps_v2.txt"))))
+cat(sprintf("testable %d; flagged %d (guild carriers %d)\n", sum(!is.na(res$score)), sum(res$flag), sum(res$flag & res$rep %in% g)))
+writeLines(res$rep[res$flag], file.path(OUT, "flagged_reps_by_batch.txt"))

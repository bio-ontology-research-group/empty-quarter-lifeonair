+LAB <- c("[NiFe] 1l", "[NiFe] 1h", "[NiFe] 2a", "CoxL form I", "other [NiFe]", "other CoxL")
+COL <- c(C1L, C1H, C2A, CFI, GREY, GREY)
+ttl <- function(s) title(main = s, adj = 0, cex.main = 1.05, font.main = 2, col.main = INK)
